# Modelo dos "Secrets" do Streamlit Community Cloud.
# No site: App > Settings > Secrets > cole este conteúdo preenchido.
# NUNCA envie o arquivo secrets.toml real para o GitHub.

GROQ_API_KEY = "gsk_..."
# GEMINI_API_KEY = "..."

MODO_PUBLICO = "1"          # esconde a opção Ollama (que só funciona localmente)
LIMITE_IA_SESSAO = "15"     # perguntas/relatórios por visitante usando a sua chave

AUTOR = "Seu Nome"
LINK_GITHUB = "https://github.com/seu-usuario/seu-repositorio"
LINK_LINKEDIN = "https://www.linkedin.com/in/seu-perfil"
